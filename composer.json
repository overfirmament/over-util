{
    "name": "overfirmament/over-util",
    "type": "library",
    "description": "A Laravel Util Package",
    "keywords": [
        "laravel",
        "package",
        "util"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "ext-dom": "*",
        "ext-iconv": "*",
        "ext-json": "*",
        "ext-mbstring": "*",
        "ext-sockets": "*",
        "ext-zlib": "*",
        "laravel/framework": "^12.0 || ^13.0",
        "monolog/monolog": "^3.4",
        "php-amqplib/php-amqplib": "^3.7",
        "saloonphp/laravel-plugin": "^4.0",
        "saloonphp/saloon": "^4.0",
        "spatie/laravel-data": "^4.18"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.0",
        "orchestra/testbench": "^10.12 || ^11.3",
        "phpcompatibility/php-compatibility": "^9.3",
        "phpunit/phpunit": "^11.5 || ^12.5",
        "squizlabs/php_codesniffer": "^3.10"
    },
    "autoload": {
        "psr-4": {
            "Overfirmament\\OverUtils\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Overfirmament\\OverUtils\\Tests\\": "tests/"
        }
    },
    "authors": [
        {
            "name": "overfirmament",
            "email": "lxz413@gmail.com"
        }
    ],
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse",
        "format": "pint",
        "format:test": "pint --test"
    },
    "config": {
        "sort-packages": true
    },
    "extra": {
        "laravel": {
            "providers": [
                "Overfirmament\\OverUtils\\OverUtilServiceProvider"
            ]
        }
    }
}
